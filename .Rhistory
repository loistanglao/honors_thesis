transmute(
dhs_wave       = tmp_wave,
file           = fname,
dhs_wave_inData = hv000,
dhs_year       = as.integer(hv007),
cluster_number = hv001,
hh_id          = hv002,
sample_weight  = hv005 / 10^6,  # DHS stores weights multiplied by 10^6
birth_order    = bord,
yob            = b2,
current_age    = b8,
bmi_z          = hc73 / 100     # DHS stores z-scores multiplied by 100
)
# Standardise dhs_year and yob to four-digit years.
# DHS waves inconsistently use 2- or 4-digit years;
# values < 25 are assumed to be 2000s, otherwise 1900s
keep <- keep |>
mutate(
dhs_year = case_when(
str_length(dhs_year) == 4             ~ dhs_year,
str_length(dhs_year) == 2 & dhs_year < 25 ~ dhs_year + 2000,
TRUE                                  ~ dhs_year + 1900),
yob = case_when(
str_length(yob) == 4                  ~ yob,
str_length(yob) == 2 & yob < 25       ~ yob + 2000,
TRUE                                  ~ yob + 1900)
)
# Assign each child to a 5-year birth cohort (e.g. 1990, 1995, 2000).
# First compute the decade, then offset by 5 if born in the
# second half of the decade
keep <- keep |>
mutate(
yob_decade = floor(yob / 10) * 10,
yob_5yr    = if_else(yob - yob_decade >= 5, yob_decade + 5, yob_decade)
)
# Aggregate to cluster x survey-year x birth-cohort level,
# computing household counts and BMI-based prevalence measures
out <- keep |>
group_by(file, dhs_wave, dhs_wave_inData, cluster_number, dhs_year, yob_5yr) |>
summarise(
n_households     = n_distinct(hh_id),   # number of unique households in cluster
household_members = n(),                 # total number of child observations
pr_thinness      = mean(bmi_z < -2, na.rm = TRUE),  # proportion with BMI-z < -2
pr_overweight    = mean(bmi_z >  1, na.rm = TRUE)   # proportion with BMI-z > 1
) |>
ungroup()
# Delete the unzipped DTA file(s), keeping only the original zips
setdiff(list.files("data/in/dhs/household-members-recode", full.names = TRUE), zip_files) |>
file.remove()
# Return aggregated data only, or both aggregated and individual-level
if(agg) {
return(out)
} else {
return(list(agg = out, individual = keep))
}
}
# =============================================================
# Run clusterMortality across all zip files (agg = FALSE so
# both aggregated and individual-level data are returned),
# then separate, save, and clean up
# =============================================================
# Apply function to all zip files, returning both agg and individual data
dhs_list <- map(zip_files, clusterMortality, agg = FALSE, .progress = TRUE)
# =============================================================
# Aggregate DHS Household Members Recode data by cluster and
# birth cohort, extracting child BMI z-scores to compute
# cluster-level prevalence of thinness and overweight.
# =============================================================
# Clear the R environment and free memory
rm(list = ls()); gc()
# Load required packages:
# - sf: spatial data handling
# - tidyverse: data manipulation and iteration
# - haven: reading Stata (.dta) files
pkgs <- c("sf", "tidyverse", "haven")
sapply(pkgs, require, character.only = TRUE); rm(pkgs)
# Get full file paths of all DHS household members recode zip files
zip_files <- list.files("data/in/dhs/household-members-recode", pattern = "zip", full.names = TRUE)
# =============================================================
# FUNCTION: clusterBMI
# For a given zip file f, unzips and reads the DHS household
# members recode, extracts child BMI z-scores, and returns
# either:
#   - agg = TRUE (default): cluster/cohort-level aggregates
#   - agg = FALSE: a list of both aggregated and individual-level data
# =============================================================
clusterBMI <- function(f, agg = TRUE) {
# Unzip the file and read the Stata .dta file into R
unzip(f, exdir = "data/in/dhs/household-members-recode")
dta_file <- list.files("data/in/dhs/household-members-recode", pattern = "DTA$|dta$", full.names = TRUE)
tmp <- read_dta(dta_file)
# Extract the DHS wave identifier from the filename
# e.g. "ETPR7" -> removes "PR" -> "ET7"
tmp_wave <- str_remove(f, "data/in/dhs/household-members-recode") |>
str_extract("[A-Z]{2}PR[0-9]{1}") |>
str_remove("PR")
# Extract a clean filename (no path, no .zip extension) for tracking
fname <- str_remove(f, "data/in/dhs/household-members-recode/") |>
str_remove(".zip")
# Define required DHS variables:
# hv000: DHS wave/country code (in data)
# hv007: year of survey
# hv001: cluster number
# hv002: household ID
# hv005: sample weight
# bord:  birth order of child
# b2:    year of birth of child
# b8:    current age of child
# hc73:  BMI-for-age z-score (stored x100, e.g. 150 = 1.50)
vars <- c("hv000", "hv007", "hv001", "hv002", "hv005", "bord", "b2", "b8", "hc73")
# Check which required variables are missing from this file;
# if any are absent, create them and fill with NA to ensure
# consistent structure across DHS waves
miss_vars <- vars[which(!(vars %in% names(tmp)))]
if(length(miss_vars) > 0) {tmp[, miss_vars] <- NA}
rm(miss_vars, vars)
# Retain and rename only the required variables, and
# rescale hc73 and hv005 to their true values
keep <- tmp |>
transmute(
dhs_wave       = tmp_wave,
file           = fname,
dhs_wave_inData = hv000,
dhs_year       = as.integer(hv007),
cluster_number = hv001,
hh_id          = hv002,
sample_weight  = hv005 / 10^6,  # DHS stores weights multiplied by 10^6
birth_order    = bord,
yob            = b2,
current_age    = b8,
bmi_z          = hc73 / 100     # DHS stores z-scores multiplied by 100
)
# Standardise dhs_year and yob to four-digit years.
# DHS waves inconsistently use 2- or 4-digit years;
# values < 25 are assumed to be 2000s, otherwise 1900s
keep <- keep |>
mutate(
dhs_year = case_when(
str_length(dhs_year) == 4             ~ dhs_year,
str_length(dhs_year) == 2 & dhs_year < 25 ~ dhs_year + 2000,
TRUE                                  ~ dhs_year + 1900),
yob = case_when(
str_length(yob) == 4                  ~ yob,
str_length(yob) == 2 & yob < 25       ~ yob + 2000,
TRUE                                  ~ yob + 1900)
)
# Assign each child to a 5-year birth cohort (e.g. 1990, 1995, 2000).
# First compute the decade, then offset by 5 if born in the
# second half of the decade
keep <- keep |>
mutate(
yob_decade = floor(yob / 10) * 10,
yob_5yr    = if_else(yob - yob_decade >= 5, yob_decade + 5, yob_decade)
)
# Aggregate to cluster x survey-year x birth-cohort level,
# computing household counts and BMI-based prevalence measures
out <- keep |>
group_by(file, dhs_wave, dhs_wave_inData, cluster_number, dhs_year, yob_5yr) |>
summarise(
n_households     = n_distinct(hh_id),   # number of unique households in cluster
household_members = n(),                 # total number of child observations
pr_thinness      = mean(bmi_z < -2, na.rm = TRUE),  # proportion with BMI-z < -2
pr_overweight    = mean(bmi_z >  1, na.rm = TRUE)   # proportion with BMI-z > 1
) |>
ungroup()
# Delete the unzipped DTA file(s), keeping only the original zips
setdiff(list.files("data/in/dhs/household-members-recode", full.names = TRUE), zip_files) |>
file.remove()
# Return aggregated data only, or both aggregated and individual-level
if(agg) {
return(out)
} else {
return(list(agg = out, individual = keep))
}
}
# =============================================================
# Run clusterBMI across all zip files (agg = FALSE so
# both aggregated and individual-level data are returned),
# then separate, save, and clean up
# =============================================================
# Apply function to all zip files, returning both agg and individual data
dhs_list <- map(zip_files, clusterBMI, agg = FALSE, .progress = TRUE)
# Extract and combine cluster-level aggregates across all files
dhs_agg <- bind_rows(map(dhs_list, "agg"))
write_rds(dhs_agg, "data/out/downstream/dhs-cluster-cohort-new.rds")
# Extract and combine individual-level records across all files
dhs_household_members <- bind_rows(map(dhs_list, "individual"))
write_rds(dhs_household_members, "data/out/downstream/dhs-cluster-household-members.rds")
# Clean up all intermediate objects from the environment
rm(dhs_list, dhs_agg, dhs_household_members)
